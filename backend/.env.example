NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
SIWE_DOMAIN=localhost:5173
SIWE_URI=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb://127.0.0.1:27017/certificates_local
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
DEPLOYMENT_MANIFEST_PATH=../deployments/31337.local.json
# Replace locally with at least 32 random bytes encoded as hex; never commit the value.
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
MIN_ISSUANCE_CONFIRMATIONS=1
RPC_TIMEOUT_MS=5000
MAX_HEAD_AGE_SECONDS=0
SESSION_TTL_SECONDS=28800
SIWE_NONCE_TTL_SECONDS=300
MAX_PDF_BYTES=10485760
REQUEST_TIMEOUT_MS=30000
MAX_CONCURRENT_UPLOADS=4
AUTH_RATE_PER_MIN=10
UPLOAD_RATE_PER_MIN=10
READ_RATE_PER_MIN=60
DRAFT_TTL_SECONDS=86400
INDEXER_POLL_MS=3000
INDEXER_REORG_OVERLAP=12
# manifest:local reads this public receipt hash; it does not deploy anything.
DEPLOYMENT_TRANSACTION_HASH=REPLACE_WITH_LOCAL_DEPLOYMENT_TRANSACTION_HASH
